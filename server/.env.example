PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=task_manager
# Set to "true" for managed DB hosts that require SSL (e.g. TiDB Cloud
# in production). Leave unset for local MySQL, which doesn't use SSL.
DB_SSL=false

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:3000